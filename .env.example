# Resend API key (sends sign-up and letter emails)
RESEND_API_KEY=re_xxxxxxxxx

# Zoho Mail inbox where fan club sign-ups and letters are delivered
FANCLUB_INBOX=contact@dwaynejohnsonofficial.com
ZOHO_RECEIVER_EMAIL=contact@dwaynejohnsonofficial.com

# Sender address verified in Resend (emails always go out as "The Rock Fan Club")
RESEND_FROM_EMAIL=fanclub@dwaynejohnsonofficial.com

# Primary site URL used for canonical links, sitemap, and welcome email buttons
SITE_URL=https://your-fan-site-domain.com
