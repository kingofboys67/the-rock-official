# Resend API key (sends sign-up and letter emails)
RESEND_API_KEY=re_xxxxxxxxx

# Where fan club sign-ups and letters are delivered (the fan club's own inbox)
FANCLUB_INBOX=hello@your-fan-site-domain.com

# Sender address, verified in Resend. Emails always go out as "The Rock Fan Club".
RESEND_FROM_EMAIL=fanclub@your-fan-site-domain.com

# The site's address, used for canonical links, the sitemap and email links
SITE_URL=https://your-fan-site-domain.com
