# Resend API key (delivers sign-ups & letters to your Hostinger Email inbox and sends fan welcome passes)
RESEND_API_KEY=re_xxxxxxxxx

# Hostinger Email inbox where fan club sign-ups and letters are delivered
FANCLUB_INBOX=contact@dwaynejohnsonofficial.com
HOSTINGER_RECEIVER_EMAIL=contact@dwaynejohnsonofficial.com

# Sender address on your custom domain (emails go out as "The Rock Fan Club")
RESEND_FROM_EMAIL=fanclub@dwaynejohnsonofficial.com

# Optional direct Hostinger SMTP settings (used automatically if RESEND_API_KEY is omitted)
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=contact@dwaynejohnsonofficial.com
HOSTINGER_SMTP_PASS=

# Primary site URL used for canonical links, sitemap, and welcome email buttons
SITE_URL=https://dwaynejohnsonofficial.com
